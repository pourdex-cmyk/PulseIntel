# ── Supabase ──────────────────────────────────────────────────
# Get these from: supabase.com → Project → Settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_KEY=your-service-role-key-here   # Server-side only, never expose to frontend

# ── Anthropic Claude ──────────────────────────────────────────
# Get from: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here

# ── Webhook Secrets (for verifying platform requests) ─────────
# Generate random strings: openssl rand -hex 32
SLACK_SIGNING_SECRET=your-slack-signing-secret

# Set these as the clientState when creating your Microsoft Graph subscriptions
TEAMS_CLIENT_STATE=your-teams-client-state-secret
OUTLOOK_CLIENT_STATE=your-outlook-client-state-secret

# Append ?token=<this value> to your Gmail Pub/Sub push subscription URL
GMAIL_WEBHOOK_SECRET=your-gmail-webhook-secret

# ── OAuth App Credentials ─────────────────────────────────────
# Microsoft (Teams + Outlook share one Azure app registration)
MICROSOFT_CLIENT_ID=your-azure-app-client-id
MICROSOFT_CLIENT_SECRET=your-azure-app-client-secret
MICROSOFT_TENANT_ID=common

# Google (Gmail)
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_PUBSUB_TOPIC=projects/your-project/topics/gmail-notifications

# Slack
SLACK_CLIENT_ID=your-slack-app-client-id
SLACK_CLIENT_SECRET=your-slack-app-client-secret

# ── App Config ────────────────────────────────────────────────
APP_URL=https://your-app.vercel.app
JWT_SECRET=your-jwt-secret-min-32-chars
NODE_ENV=production
