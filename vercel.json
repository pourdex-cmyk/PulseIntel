{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/oauth/microsoft/callback.js": { "runtime": "edge" },
    "api/oauth/google/callback.js":    { "runtime": "edge" },
    "api/webhooks/microsoft.js":       { "runtime": "edge" },
    "api/webhooks/google.js":          { "runtime": "edge" },
    "api/**/*.js":                     { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/app",        "destination": "/app.html" },
    { "source": "/onboarding", "destination": "/onboarding.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin",  "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,PATCH,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization, x-internal" }
      ]
    }
  ]
}
