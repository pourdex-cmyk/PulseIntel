{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/ai/*.js": { "maxDuration": 60 },
    "api/webhooks/*.js": { "maxDuration": 10 },
    "api/auth/*.js": { "maxDuration": 30 },
    "api/auth/microsoft/*.js": { "maxDuration": 30 },
    "api/auth/google/*.js": { "maxDuration": 30 },
    "api/messages/*.js": { "maxDuration": 30 },
    "api/meetings/*.js": { "maxDuration": 30 },
    "api/settings/*.js": { "maxDuration": 30 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/app",        "destination": "/app.html" },
    { "source": "/onboarding", "destination": "/onboarding.html" }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,PUT,DELETE,PATCH,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type, Authorization" }
      ]
    }
  ]
}
